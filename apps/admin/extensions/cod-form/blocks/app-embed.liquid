{% comment %}
  App Embed. Se activa con un interruptor en el editor del tema.
  1) Botón fijo: se coloca solo debajo del «Agregar al carrito» del tema.
  2) Botón flotante: pegado abajo de la pantalla; se esconde mientras el
     botón fijo (o un bloque «Formulario COD») está a la vista.
{% endcomment %}

{% if block.settings.enabled and template contains 'product' and product %}
  {%- if block.settings.auto_place -%}
    <div hidden data-cod-autoplace
      data-product-id="gid://shopify/Product/{{ product.id }}"
      data-variant-id="gid://shopify/ProductVariant/{{ product.selected_or_first_available_variant.id }}"></div>
  {%- endif -%}
  {%- if block.settings.floating -%}
    <div
      data-cod-form
      data-mode="popup"
      data-floating="true"
      data-product-id="gid://shopify/Product/{{ product.id }}"
      data-variant-id="gid://shopify/ProductVariant/{{ product.selected_or_first_available_variant.id }}"
    ></div>
  {%- endif -%}
  <script src="{{ 'widget.js' | asset_url }}" type="module"></script>
{% endif %}

{% schema %}
{
  "name": "COD Forms",
  "target": "body",
  "settings": [
    { "type": "checkbox", "id": "enabled", "label": "Activar el formulario COD", "default": true },
    {
      "type": "checkbox",
      "id": "auto_place",
      "label": "Botón «Comprar ahora» debajo de «Agregar al carrito»",
      "info": "Se coloca solo en la página de producto. Si añades el bloque «Formulario COD» en una sección, se usa ese lugar en su lugar.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "floating",
      "label": "Botón flotante abajo de la pantalla",
      "info": "Aparece al bajar y se esconde mientras el otro botón está a la vista.",
      "default": true
    }
  ]
}
{% endschema %}
