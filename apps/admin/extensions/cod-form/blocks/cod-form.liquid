{% comment %}
  App Block (Theme App Extension).
  El merchant lo añade desde el editor del tema. CERO modificaciones de código.
  Nada de ScriptTag: está prohibido por Built for Shopify y ralentiza el tema.
{% endcomment %}

<div
  data-cod-form
  {% if block.settings.mode != 'app' %}data-mode="{{ block.settings.mode }}"{% endif %}
  data-product-id="gid://shopify/Product/{{ product.id }}"
  data-variant-id="gid://shopify/ProductVariant/{{ product.selected_or_first_available_variant.id }}"
  {{ block.shopify_attributes }}
></div>

{% comment %} defer: no bloquea el render del tema. {% endcomment %}
<script src="{{ 'widget.js' | asset_url }}" type="module"></script>

{% schema %}
{
  "name": "Formulario COD",
  "target": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "El diseño, los campos y las reglas se configuran desde el panel de la app COD Forms."
    },
    {
      "type": "select",
      "id": "mode",
      "label": "Cómo se muestra",
      "options": [
        { "value": "app", "label": "Como esté en la app (Ajustes del formulario)" },
        { "value": "embedded", "label": "Formulario completo en la página" },
        { "value": "popup", "label": "Botón «Comprar ahora» que abre el formulario" }
      ],
      "default": "app"
    }
  ]
}
{% endschema %}
