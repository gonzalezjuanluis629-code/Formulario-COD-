{% comment %}
  App Block (Theme App Extension).
  El merchant lo añade desde el editor del tema en CUALQUIER sección.
  Producto: el elegido en el bloque, o el de la sección (producto destacado…),
  o el de la página de producto.
{% endcomment %}

{%- liquid
  assign p = block.settings.product
  if p == blank
    assign p = closest.product
  endif
  if p == blank
    assign p = product
  endif
-%}

{%- if p != blank -%}
  <div
    data-cod-form
    {% if block.settings.mode != 'app' %}data-mode="{{ block.settings.mode }}"{% endif %}
    data-product-id="gid://shopify/Product/{{ p.id }}"
    data-variant-id="gid://shopify/ProductVariant/{{ p.selected_or_first_available_variant.id }}"
    style="margin: {{ block.settings.margin }}px 0"
    {{ block.shopify_attributes }}
  ></div>
  <script src="{{ 'widget.js' | asset_url }}" type="module"></script>
{%- elsif request.design_mode -%}
  <div {{ block.shopify_attributes }}
    style="padding:14px;border:1.5px dashed #b5b5b5;border-radius:10px;color:#666;font:14px/1.4 system-ui;text-align:center">
    <b>Formulario COD</b><br>
    Esta sección no tiene producto. Elige uno en «Producto» (a la derecha) o pon el bloque en la página de producto.
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Formulario COD",
  "target": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "El diseño, los campos y las ofertas se configuran en la app COD Forms."
    },
    {
      "type": "select",
      "id": "mode",
      "label": "Cómo se muestra",
      "options": [
        { "value": "app", "label": "Como esté en la app (Ajustes del formulario)" },
        { "value": "embedded", "label": "Formulario completo aquí" },
        { "value": "popup", "label": "Botón «Comprar ahora» aquí (abre el formulario)" }
      ],
      "default": "app"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Producto (opcional)",
      "info": "Déjalo vacío para usar el producto de la página."
    },
    {
      "type": "range",
      "id": "margin",
      "label": "Espacio arriba y abajo",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 8
    }
  ]
}
{% endschema %}
