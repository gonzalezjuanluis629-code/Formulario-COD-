{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["DOM", "DOM.Iterable", "ES2022"], "jsx": "react-jsx",
    "strict": true, "skipLibCheck": true, "esModuleInterop": true,
    "resolveJsonModule": true, "noEmit": true, "types": ["vite/client"]
  },
  "include": ["app/**/*", "../../packages/**/*"]
}
