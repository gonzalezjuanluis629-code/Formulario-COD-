# TLS automatico via Let's Encrypt.
admin.tudominio.com {
	encode zstd gzip
	reverse_proxy admin:3000
}

api.tudominio.com {
	encode zstd gzip

	# Bundle del widget: servido a TODOS los visitantes de la tienda.
	# Nombres con hash -> cacheable para siempre.
	handle /widget/* {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		header Access-Control-Allow-Origin "*"
		file_server
	}

	reverse_proxy api:3001
}
