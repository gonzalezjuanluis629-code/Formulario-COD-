# ─── Core ──────────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=3001
PUBLIC_API_URL=https://api.tudominio.com

# ─── Postgres ──────────────────────────────────────────────────────
POSTGRES_USER=cod
POSTGRES_PASSWORD=cambiame
POSTGRES_DB=cod
DATABASE_URL=postgresql://cod:cambiame@postgres:5432/cod?schema=public

# ─── Redis ─────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ─── Cifrado (Camino A: multi-tenant) ──────────────────────────────
# 32 bytes en base64. Genera con: openssl rand -base64 32
MASTER_ENCRYPTION_KEY=
# Pepper para hashear telefono/email (HMAC). openssl rand -hex 32
PII_HASH_PEPPER=

# ─── Shopify ───────────────────────────────────────────────────────
# CAMINO A: NO hay un unico client_id global. Las credenciales de cada
# custom app viven en la tabla `ShopifyApp` (cifradas). Estas vars solo
# sirven para el bootstrap de la PRIMERA app via `pnpm db:seed`.
SHOPIFY_APP_HANDLE=tienda-a
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_SCOPES=write_orders,read_orders,read_products,read_customers,write_customers,write_draft_orders
SHOPIFY_API_VERSION=2025-07

# ─── Google Maps Platform ──────────────────────────────────────────
# Key SERVIDOR: restringida por IP del VPS. Geocoding + Places.
GOOGLE_MAPS_SERVER_KEY=
# Key NAVEGADOR: restringida por HTTP referrer, SOLO Maps JavaScript API.
GOOGLE_MAPS_BROWSER_KEY=
GEOCODING_PROVIDER=google
GEOCODING_DAILY_QUOTA_PER_SHOP=2000

# ─── Observabilidad ────────────────────────────────────────────────
SENTRY_DSN=
LOG_LEVEL=info
